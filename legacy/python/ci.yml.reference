name: checks
on:
  push:
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  test:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        python: ['3.12', '3.14']
    runs-on: ${{ matrix.os }}
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - if: runner.os == 'Linux'
        run: sudo apt-get update && sudo apt-get install -y libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-dejavu-core bubblewrap
      - if: runner.os == 'macOS'
        run: brew install pango
      - if: runner.os == 'Windows'
        uses: msys2/setup-msys2@v2
        id: msys2
        with:
          msystem: UCRT64
          install: mingw-w64-ucrt-x86_64-pango
      - if: runner.os == 'Windows'
        shell: pwsh
        env:
          MSYS2_LOCATION: ${{ steps.msys2.outputs.msys2-location }}
        run: '"WEASYPRINT_DLL_DIRECTORIES=$env:MSYS2_LOCATION\ucrt64\bin" >> $env:GITHUB_ENV'
      - run: python -m pip install uv==0.13.7
      - run: uv sync --locked --extra test --group dev --python ${{ matrix.python }}
      - run: uv run --locked ruff check .
      - run: uv run --locked ruff format --check src tests scripts
      - run: uv run --locked pytest
      - run: uv run --locked python -m build
      - name: Test the installed wheel without the source import path
        shell: bash
        run: |
          uv pip install --reinstall --no-deps dist/*.whl
          uv run --no-sync pytest -o pythonpath= --import-mode=importlib
      - if: runner.os == 'Linux' && matrix.python == '3.12'
        name: Audit locked dependencies
        run: uv run --locked pip-audit --skip-editable
  office:
    runs-on: macos-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: brew install --cask libreoffice
      - run: python -m pip install uv==0.13.7
      - run: uv sync --locked --extra test --group dev --python 3.12
      - name: Test real Office conversion inside the OS sandbox
        env:
          MSG2PDF_TEST_OFFICE: '1'
        run: uv run --locked pytest tests/test_office_integration.py tests/test_security.py
