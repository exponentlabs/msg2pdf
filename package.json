{
  "name": "msg2pdf",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Exponent Labs"
  },
  "description": "An offline email-to-PDF workbench for desktop and terminal.",
  "homepage": "https://github.com/exponentlabs/msg2pdf#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/exponentlabs/msg2pdf.git"
  },
  "bugs": {
    "url": "https://github.com/exponentlabs/msg2pdf/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "cli": "node scripts/cli.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:check": "node scripts/check-doc-links.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm docs:check && pnpm test && pnpm build && pnpm test:e2e",
    "package:dir": "pnpm build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "package": "pnpm build && electron-builder --config electron-builder.config.cjs --publish never",
    "package:release": "node scripts/release.mjs",
    "icon": "electron scripts/icon.cjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "licenses:generate": "node scripts/licenses.mjs",
    "audit:production": "pnpm audit --prod --audit-level high",
    "source:archive": "node scripts/source-archive.mjs"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "0.1.3",
    "@kenjiuno/msgreader": "1.29.0",
    "commander": "15.0.0",
    "iconv-lite": "0.7.3",
    "lucide-react": "1.71.0",
    "mailparser": "3.14.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rtf-stream-parser": "4.0.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "cfb": "1.2.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
